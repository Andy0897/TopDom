@model TopDom.ViewModels.Cart.CartViewModel
@{
    ViewData["Title"] = "Количка";
}

<div class="container page-section">
    <h2 class="mb-4">Моята количка</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <p class="mb-3">Количката е празна.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Разгледай продуктите</a>
        </div>
    }
    else
    {
        <div class="table-card mb-4">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th></th>
                        <th>Продукт</th>
                        <th>Цена</th>
                        <th>Количество</th>
                        <th>Общо</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <img src="@(item.HasImage ? Url.Action("Image", "Products", new { id = item.ProductId }) : "/images/no-image.png")"
                                     style="width:56px;height:56px;object-fit:cover;border-radius:6px;" alt="@item.ProductName" />
                            </td>
                            <td>@item.ProductName</td>
                            <td>@item.Price.ToString("0.00") лв.</td>
                            <td style="width:150px;">
                                <form asp-action="UpdateQuantity" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.Stock" class="form-control form-control-sm qty-input" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">✓</button>
                                </form>
                            </td>
                            <td class="fw-semibold">@item.Total.ToString("0.00") лв.</td>
                            <td>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Премахни</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Общо: <span class="price">@Model.GrandTotal.ToString("0.00") лв.</span></h4>
            <a asp-controller="Orders" asp-action="Checkout" class="btn btn-primary btn-lg">Завърши поръчката</a>
        </div>
    }
</div>