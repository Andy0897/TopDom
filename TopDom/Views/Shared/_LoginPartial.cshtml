<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Create">Нов продукт</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Категории</a></li>
        }
        else
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Количка</a></li>
        }
        @if (User.IsInRole("User"))
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="MyOrders">Моите поръчки</a></li>
        }
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="AllOrders">Поръчки</a></li>
        }
        <li class="nav-item"><span class="nav-link">@User.Identity.Name</span></li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Logout">Изход</a>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Регистрация</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Вход</a></li>
    }
</ul>