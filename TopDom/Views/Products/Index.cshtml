@model TopDom.ViewModels.Products.ProductListViewModel
@{
    ViewData["Title"] = "Продукти";
}

<div class="container page-section">
    <div class="page-header">
        <h2>Продукти</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">Нов продукт</a>
        }
    </div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Търсене по име..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name", Model.CategoryId))">
                <option value="">Всички категории</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100">Търси</button>
        </div>
    </form>

    @if (!Model.Products.Any())
    {
        <div class="empty-state">
            <p class="mb-0">Няма намерени продукти.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var p in Model.Products)
            {
                <div class="col">
                    <div class="card-product">
                        <img src="@(p.HasImage ? Url.Action("Image", new { id = p.Id }) : "/images/no-image.png")" alt="@p.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@p.Name</h5>
                            <p class="text-muted small mb-2">@p.CategoryName</p>
                            <p class="price mb-3">@p.Price.ToString("0.00") лв.</p>
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary w-100">Детайли</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>