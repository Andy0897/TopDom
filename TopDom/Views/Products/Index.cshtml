@model TopDom.ViewModels.Products.ProductListViewModel
@{
    ViewData["Title"] = "Продукти";
}

<form method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Търсене по име..." />
    </div>
    <div class="col-md-4">
        <select name="categoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name", Model.CategoryId))">
            <option value="">Всички категории</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Търси</button>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var p in Model.Products)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@(p.HasImage ? Url.Action("Image", new { id = p.Id }) : "/images/no-image.png")"
                     class="card-img-top" style="height:200px; object-fit:cover;" />
                <div class="card-body">
                    <h5 class="card-title">@p.Name</h5>
                    <p class="text-muted">@p.CategoryName</p>
                    <p class="fw-bold">@p.Price.ToString("0.00") лв.</p>
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-primary w-100">Детайли</a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}