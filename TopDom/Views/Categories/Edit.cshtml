@model TopDom.ViewModels.Categories.CategoryFormViewModel
@{
    ViewData["Title"] = "Редакция на категория";
}

<div class="container page-section">
    <div class="crumb"><a asp-controller="Categories" asp-action="Index">Категории</a> / Редакция</div>
    <h2 class="mb-4">Редакция на категория</h2>

    <div class="form-card">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Запази промените</button>
                <a asp-action="Index" class="btn btn-outline-primary">Отказ</a>
            </div>
        </form>
    </div>
</div>